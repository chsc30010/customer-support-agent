# --- Twilio (only needed to take real calls and texts) ---
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
# Public base URL Twilio reaches this server on. Signature validation hashes the
# full request URL, so this must match the webhook URL configured in Twilio
# exactly -- scheme, host, port and path.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# Where escalated calls are transferred. E.164.
HANDOFF_PHONE_NUMBER=
# Set to 1 only for local curl testing. Never in production: it disables
# Twilio request signature verification.
ALLOW_UNSIGNED_WEBHOOKS=0

# --- Language model (optional; the agent runs fully without it) ---
# One of: none, anthropic. With "none" the agent uses its deterministic
# classifier and extractive answerer, which is a complete, working system.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- Thresholds ---
# Below this classifier confidence the agent hands off instead of guessing.
MIN_INTENT_CONFIDENCE=0.35
# Below this retrieval score there is nothing to ground an answer in.
MIN_RETRIEVAL_SCORE=2.5
# Customer turns without resolution before the agent gives up and escalates.
MAX_TURNS_BEFORE_HANDOFF=4

# --- Decision journal ---
# One JSONL line per turn: what the agent decided and why. Off unless a path
# is set, because recording what customers said is a deliberate choice.
# Feeds `support-agent gaps` and `support-agent shadow`.
DECISION_LOG=
# Mask emails, phone numbers and card-shaped digit runs before writing. Leave
# this on unless you have a specific reason and somewhere safe to put the file.
JOURNAL_REDACT=1
